{
  "name": "auto-commit-msg",
  "displayName": "auto-commit-msg",
  "description": "One feature: It writes commit messages for you.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "auto-commit-msg.generateCommit",
        "title": "Auto Commit Message: Generate Commit",
        "icon": "$(sparkle)"
      },
      {
        "command": "auto-commit-msg.configureProvider",
        "title": "Auto Commit Message: Configure Provider"
      },
      {
        "command": "auto-commit-msg.setApiKey",
        "title": "Auto Commit Message: Set API Key"
      },
      {
        "command": "auto-commit-msg.removeApiKey",
        "title": "Auto Commit Message: Remove API Key"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "auto-commit-msg.generateCommit",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Auto Commit Message",
      "properties": {
        "autoCommitMsg.provider": {
          "type": "string",
          "enum": [
            "",
            "openai",
            "anthropic",
            "gemini"
          ],
          "enumDescriptions": [
            "Not configured",
            "OpenAI API",
            "Anthropic API",
            "Gemini API"
          ],
          "default": "",
          "scope": "application",
          "description": "The provider used to generate commit messages."
        },
        "autoCommitMsg.openaiModel": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "The OpenAI model name."
        },
        "autoCommitMsg.anthropicModel": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "The Anthropic model name."
        },
        "autoCommitMsg.geminiModel": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "The Gemini model name."
        },
        "autoCommitMsg.customInstructions": {
          "type": "string",
          "default": "",
          "scope": "application",
          "editPresentation": "multilineText",
          "description": "Extra instructions appended to every prompt, such as a house convention or a required issue trailer. These take precedence over the convention detected from recent commits."
        },
        "autoCommitMsg.commitDirectly": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Commit staged changes immediately after you confirm the generated subject, instead of writing it into the Source Control input box for review. Splitting an unstaged tree always commits directly."
        },
        "autoCommitMsg.maxDiffCharacters": {
          "type": "integer",
          "minimum": 1000,
          "default": 64000,
          "scope": "application",
          "description": "Upper bound on the diff characters sent to the provider. Larger diffs are truncated and you are told when that happens."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "mocha": "^11.7.6",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
